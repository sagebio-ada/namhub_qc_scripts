+
+
+# FqLintTest and RawReadQcTest share their command shape and their
+# compute_status() override (compute_status_with_json_metrics), so the same
+# tests run for both classes.
+JSON_METRICS_TESTS = [
+    pytest.param(tests.FqLintTest, FQ_LINT_CONTAINER, id="FqLintTest"),
+    pytest.param(tests.RawReadQcTest, RAW_READ_QC_CONTAINER, id="RawReadQcTest"),
+]
+
+
+@pytest.mark.parametrize("test_class, container", JSON_METRICS_TESTS)
+class TestJsonMetricsFastqTests:
+    @pytest.fixture(scope="function", autouse=True)
+    def setup_method(self, test_files, tmp_path):
+        files = [test_files["good_fastq"], test_files["good_compressed_fastq"]]
+        self.target = PairedTarget(files)
+        self.tmp_path = tmp_path
+
+    def get_status_for(self, test, mocker, std_out, std_err, exit_code):
+        """Give the test fake container outputs and compute its status."""
+        outputs = {
+            "std_out": self.tmp_path / "std_out.txt",
+            "std_err": self.tmp_path / "std_err.txt",
+            "exit_code": self.tmp_path / "exit_code.txt",
+        }
+        outputs["std_out"].write_text(std_out)
+        outputs["std_err"].write_text(std_err)
+        outputs["exit_code"].write_text(exit_code)
+        mocker.patch.object(test, "_find_process_outputs", return_value=outputs)
+        return test.get_status()
+
+    def test_that_the_command_runs_the_entry_file_on_both_files(
+        self, test_class, container
+    ):
+        process = test_class(self.target).generate_process()
+        assert process.container == container
+        assert process.command == (
+            "python3 /app/run.py 'fastq1.fastq' 'fastq2.fastq.gz'"
+        )
+
+    def test_that_exit_code_0_passes_and_reads_the_metrics(
+        self, test_class, container, mocker
+    ):
+        test = test_class(self.target)
+        status = self.get_status_for(test, mocker, '{"files": []}', "", "0")
+        assert status == TestStatus.PASS
+        assert test.metrics == {"files": []}
+        assert test.status_reason == ""
+
+    def test_that_exit_code_1_fails_and_reads_the_metrics_and_reason(
+        self, test_class, container, mocker
+    ):
+        test = test_class(self.target)
+        status = self.get_status_for(
+            test, mocker, '{"n_errors": 1}', "fastq1.fastq: bad record", "1"
+        )
+        assert status == TestStatus.FAIL
+        assert test.metrics == {"n_errors": 1}
+        assert test.status_reason == "fastq1.fastq: bad record"
+
+    def test_that_exit_code_2_is_an_error_and_the_metrics_are_not_read(
+        self, test_class, container, mocker
+    ):
+        test = test_class(self.target)
+        status = self.get_status_for(
+            test, mocker, '{"partial": true}', "fastq1.fastq: file not found", "2"
+        )
+        assert status == TestStatus.ERROR
+        assert test.metrics == {}
+        assert test.status_reason == "fastq1.fastq: file not found"
+
+    def test_that_stdout_that_is_not_json_is_an_error(
+        self, test_class, container, mocker
+    ):
+        test = test_class(self.target)
+        status = self.get_status_for(test, mocker, "not json", "a warning", "0")
+        assert status == TestStatus.ERROR
+        assert test.metrics == {}
+        assert test.status_reason == (
+            "Tool wrote output that is not a JSON object\na warning"
+        )
+
+    def test_that_a_json_value_that_is_not_an_object_is_an_error(
+        self, test_class, container, mocker
+    ):
+        test = test_class(self.target)
+        status = self.get_status_for(test, mocker, "[1, 2]", "", "1")
+        assert status == TestStatus.ERROR
+        assert test.status_reason == "Tool wrote output that is not a JSON object"
+
+    def test_that_empty_stdout_passes_with_no_metrics(
+        self, test_class, container, mocker
+    ):
+        test = test_class(self.target)
+        status = self.get_status_for(test, mocker, "", "", "0")
+        assert status == TestStatus.PASS
+        assert test.metrics == {}
