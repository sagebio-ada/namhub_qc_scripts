+        )
+        assert status == TestStatus.ERROR
+        assert test.metrics == {}
+        assert test.status_reason == "fastq1.fastq: file not found"
+
+    def test_that_stdout_that_is_not_json_is_an_error(self, mocker):
+        test = self.test_class(self.target)
