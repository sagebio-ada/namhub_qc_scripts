+"""Goes in py-dcqc at src/dcqc/tests/fq_lint_test.py.
+
+Image: scrnaseq_qc_pipeline/checks/py_dcqc/fq_lint in namhub_qc_scripts.
+"""
+
+from dcqc.target import PairedTarget
+from dcqc.tests.base_test import ExternalBaseTest, Process, TestStatus, TestTier
+from dcqc.tests.constants import FQ_LINT_CONTAINER
+from dcqc.tests.json_stdout_metrics import compute_status_with_json_metrics
+
+
+class FqLintTest(ExternalBaseTest[PairedTarget]):
+    """Tests that each FASTQ file of a pair is structurally valid (fq lint).
+
+    Each file is linted on its own; the paired read-name check is not done.
+    Exit codes: 0 pass, 1 a file is malformed, 2 the check could not run
+    (for example, a missing file).
+    """
+
+    tier = TestTier.INTERNAL_CONFORMANCE
+    pass_code = 0
+    fail_code = 1
+    failure_reason_location = "std_err"
+
+    def generate_process(self) -> Process:
+        paths = [file.stage() for file in self.target.files]
+        command_args = ["python3", "/app/run.py", *(f"'{path.name}'" for path in paths)]
+        return Process(container=FQ_LINT_CONTAINER, command_args=command_args)
+
+    def compute_status(self) -> TestStatus:
+        return compute_status_with_json_metrics(self)
diff --git a/src/dcqc/tests/json_stdout_metrics.py b/src/dcqc/tests/json_stdout_metrics.py
new file mode 100644
index 0000000..f5a43a2
--- /dev/null
+++ b/src/dcqc/tests/json_stdout_metrics.py
@@ -0,0 +1,40 @@
+"""Read an external test's metrics from the JSON object its container
+writes to stdout.
+
+Goes in py-dcqc at src/dcqc/tests/json_stdout_metrics.py. Follows the
+compute_status() example in py-dcqc's ARCHITECTURE.md ("Creating the Test
+Class"): the base class never reads metrics from the container, so an
+external test's metrics stay {} unless its class overrides compute_status().
+"""
+
+import json
+
+from dcqc.tests.base_test import ExternalTestMixin, TestStatus
+
+
+def compute_status_with_json_metrics(test: ExternalTestMixin) -> TestStatus:
+    """Interpret the exit code as usual, then load stdout into test.metrics.
+
+    Metrics are read only for passed and failed tests; after an error,
+    stdout can hold partial output. Stdout that is not one JSON object makes
+    the status error, with stderr kept in status_reason.
+    """
+    outputs = test._find_process_outputs()
+    status = test._interpret_process_outputs(outputs)
+    if status not in (TestStatus.PASS, TestStatus.FAIL):
+        return status
+
+    text = outputs["std_out"].read_text().strip()
+    if not text:
+        return status
+    try:
+        metrics = json.loads(text)
+    except json.JSONDecodeError:
+        metrics = None
+    if not isinstance(metrics, dict):
+        reason = "Tool wrote output that is not a JSON object"
+        std_err = outputs["std_err"].read_text()
+        test.status_reason = f"{reason}\n{std_err}" if std_err else reason
+        return TestStatus.ERROR
+    test.metrics = metrics
+    return status
